{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":ignoreModulesAndTests", "workarounds:all", "packages:eslint"],
  "dependencyDashboard": true,
  "timezone": "America/Los_Angeles",
  "schedule": "before 6:00pm on Friday",
  "postUpdateOptions": [
    "npmDedupe",
    "yarnDedupeHighest",
    "pnpmDedupe",
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "groupName": "patch+minor",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "groupName": "digest",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    },
    {
      "description": "Github Actions",
      "groupName": "digest",
      "matchSourceUrls": ["https://github.com/**/*"],
      "matchUpdateTypes": ["digest"],
      "changelogUrl": "{{sourceUrl}}/compare/{{currentDigest}}..{{newDigest}}",
      "automerge": false
    },
    {
      "groupName": "major",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "@types/eslint",
        "babel-eslint",
        "@babel/eslint-parser",
        "@eslint/**",
        "@eslint-community/**",
        "@stylistic/eslint-plugin*",
        "@types/eslint__*",
        "@typescript-eslint/**",
        "typescript-eslint",
        "eslint*"
      ],
      "updateTypes": ["major"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt"],
      "updateTypes": ["major"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt"],
      "updateTypes": ["minor"]
    },
    {
      "groupName": "Design System",
      "matchPackageNames": ["@heroui/**", "*tailwind*", "@internationalized/date"]
    },
    {
      "groupName": "React/Next",
      "matchPackageNames": [
        "next-*",
        "@next/**",
        "react",
        "@types/react",
        "react-*",
        "@types/react-*"
      ],
      "updateTypes": ["major"]
    },
    {
      "groupName": "Storybook",
      "matchPackageNames": ["@storybook/**", "storybook*", "@chromatic-com/storybook"],
      "updateTypes": ["major"]
    },
    {
      "matchPackagePatterns": ["postgres"],
      "updateTypes": ["major"],
      "enabled": false
    },
    {
      "groupName": "Echo",
      "matchPackageNames": ["github.com/labstack/echo/v*"],
      "enabled": true
    }
  ]
}
